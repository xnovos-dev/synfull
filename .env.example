# Local-only default. Set 0.0.0.0 only behind a trusted firewall and authentication layer.
SYNFULL_BIND_HOST=127.0.0.1
SYNFULL_BIND_PORT=8000
# SYNFULL_STATE_DIR=/custom/writable/path/synfull
# SYNFULL_DATABASE_PATH=/custom/writable/path/synfull.sqlite3
SYNFULL_COLLECTION_INTERVAL_SECONDS=5
SYNFULL_METRIC_RETENTION_DAYS=30
SYNFULL_DEVELOPMENT=false
# Optional integration settings:
# SYNFULL_DOCKER_ENDPOINT=tcp://127.0.0.1:2376
# SYNFULL_PM2_EXECUTABLE=/path/to/pm2
# SYNFULL_PM2_OWNER=service-account
# SYNFULL_SERVICE_ALLOWLIST=ssh,nginx
# SYNFULL_INITIAL_ADMIN_TOKEN=configure-a-random-token-before-enabling-setup
