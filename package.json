{
  "name": "synfull",
  "version": "0.1.4",
  "description": "Local-first cross-platform host monitoring dashboard",
  "license": "MIT",
  "type": "commonjs",
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "synfull": "scripts/synfull.cjs"
  },
  "files": [
    "backend/app/**/*.py",
    "backend/requirements-runtime.txt",
    "frontend/dist",
    "scripts/synfull.cjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "linux"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python -m pytest backend/tests",
    "test:frontend": "npm --prefix frontend run lint",
    "prepack": "npm --prefix frontend ci && npm --prefix frontend run build"
  },
  "keywords": [
    "monitoring",
    "system-monitor",
    "dashboard",
    "linux",
    "windows"
  ]
}
